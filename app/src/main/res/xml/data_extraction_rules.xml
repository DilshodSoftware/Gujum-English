<data-extraction-rules>
    <cloud-backup>
        <!-- Lug'at bazasi assetdan olinadi — eski nusxa qayta tiklanmasin -->
        <exclude domain="database" path="dictionary.db"/>
        <exclude domain="database" path="dictionary.db-journal"/>
        <exclude domain="database" path="dictionary.db-wal"/>
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>